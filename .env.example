# Supabase (read by Gradle into BuildConfig; real values go in local.properties or .env)
SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=       # public anon key; security comes from RLS. Never put the service role key here.

# Auth
ALLOWED_EMAIL_DOMAIN=    # university email domain, e.g. student.example.ac.id
