# Supabase (read by Gradle into BuildConfig; real values go in local.properties or .env)
SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=       # public anon key; security comes from RLS. Never put the service role key here.

# Google sign-in (optional; blank hides the button)
GOOGLE_WEB_CLIENT_ID=    # OAuth *web* client ID from Google Cloud, the same one set on the Supabase Google provider

